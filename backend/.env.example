SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
FRONTEND_ORIGIN=https://YOUR_FRONTEND_ORIGIN

# Production hardening. Include every hostname used to reach this API.
BACKEND_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# 10 MiB health document plus multipart overhead.
MAX_REQUEST_BODY_BYTES=12582912
POSTURE_UPLOAD_MAX_REQUEST_BYTES=50262144
API_DOCS_ENABLED=false
ENABLE_TEST_ENDPOINTS=false

# Keep disabled until the AI server validates the shared Bearer key.
CHAT_AI_ENABLED=false
# Exact trusted AI endpoint, e.g. https://your-ai-service.example/chat
CHAT_AI_URL=
# Server-to-server secret, NOT an OpenAI key or a frontend public variable.
CHAT_AI_API_KEY=

# Structured diet and running AI endpoints. Enable when the AI origin and key are ready.
# The base URL is an HTTPS origin (no /chat path); key stays on the backend.
AI_SERVER_ENABLED=false
AI_SERVER_BASE_URL=
AI_SERVER_API_KEY=
# Enable only after the posture migration and video upload/cleanup flow are deployed.
POSTURE_ANALYSIS_WRITE_ENABLED=false
# POSTURE_ANALYSIS_CLEANUP_ENABLED=true  # keep cleanup on if writes are later disabled
# Enable only after the exercise AI catalog migration and runtime smoke test.
EXERCISE_AI_ENABLED=false
# Optional pilot: when present, only these authenticated user UUIDs use exercise AI.
# This overrides EXERCISE_AI_ENABLED, even when the value is empty. Remove it for full rollout.
# EXERCISE_AI_TEST_USER_IDS=
# Public HTTPS prefix containing the CSV's gender/mode GIF paths. Leave blank until assets are uploaded.
EXERCISE_GIF_BASE_URL=

# Trusted OCR adapter: accepts multipart file (+ optional document_type), detects type when omitted, returns typed extracted_data.
# Without a URL, all supported files return samples without classifying content.
# Optional type omitted: use this server-side sample type (health_checkup/body_composition).
HEALTH_DOCUMENT_OCR_MOCK_DOCUMENT_TYPE=health_checkup
# Set MOCK_ENABLED=false to return OCR_NOT_CONFIGURED instead.
HEALTH_DOCUMENT_OCR_MOCK_ENABLED=false
# Set this to the OCR service's HTTPS origin plus /ai/ocr. Keep the Bearer token server-only.
HEALTH_DOCUMENT_OCR_URL=
HEALTH_DOCUMENT_OCR_TOKEN=
