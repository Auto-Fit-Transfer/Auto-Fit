{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true
    },
    "testflight": {
      "extends": "production",
      "distribution": "store",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://auto-fit-api-dev.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
