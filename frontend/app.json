{
  "expo": {
    "name": "Auto-Fit Test",
    "slug": "auto-fit-test",
    "owner": "gogosi",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "autofit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gogosi.autofit.test",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.gogosi.autofit.test"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "식사 기록과 건강 데이터를 촬영하려면 카메라 접근 권한이 필요합니다.",
          "microphonePermission": false,
          "photosPermission": "식사 기록에 사진을 추가하려면 사진 보관함 접근 권한이 필요합니다."
        }
      ],
      "expo-document-picker",
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf91d1cc-3be2-495f-8a2a-60d65da21056"
      }
    }
  }
}
