EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional: omit to use the default in src/api/client.ts.
EXPO_PUBLIC_API_BASE_URL=https://211-233-206-193.sslip.io

# Optional: Kakao Maps JavaScript key for the running course map. Without it the app draws the route as a line.
# EXPO_PUBLIC_KAKAO_MAP_JS_KEY=
# The origin registered with that key. Defaults to the API server address.
# EXPO_PUBLIC_KAKAO_MAP_ORIGIN=
