# Copy to api.env on the server, replace placeholders, and chmod 600.
# AI_SERVER_API_KEY must equal ai.env; HEALTH_DOCUMENT_OCR_TOKEN must equal ocr.env.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
FRONTEND_ORIGIN=https://YOUR_FRONTEND_ORIGIN
MAX_REQUEST_BODY_BYTES=12582912
API_DOCS_ENABLED=false
ENABLE_TEST_ENDPOINTS=false

CHAT_AI_ENABLED=false
CHAT_AI_URL=
CHAT_AI_API_KEY=
AI_SERVER_ENABLED=true
AI_SERVER_BASE_URL=https://ai.example.com
AI_SERVER_API_KEY=
FOOD_IMAGE_ENABLED=false
FOOD_IMAGE_URL=
FOOD_IMAGE_API_KEY=
FOOD_IMAGE_FORMAT=webp
FOOD_IMAGE_TIMEOUT_SECONDS=300
FOOD_IMAGE_MAX_ATTEMPTS=2
HEALTH_DOCUMENT_OCR_URL=https://ocr.example.com/ai/ocr
HEALTH_DOCUMENT_OCR_TOKEN=
HEALTH_DOCUMENT_OCR_MOCK_ENABLED=false
DIET_REFRESH_CRON_TOKEN=replace_me

# Historical exercise recommendations are archived. Keep AI restricted; an empty allowlist blocks new generation and analysis.
EXERCISE_AI_ENABLED=false
EXERCISE_AI_TEST_USER_IDS=
# Existing private NCP bucket and optional immutable object prefix.
EXERCISE_GIF_BUCKET=
EXERCISE_GIF_PREFIX=
EXERCISE_GIF_URL_TTL_SECONDS=14400
NCP_ACCESS_KEY_ID=
NCP_SECRET_ACCESS_KEY=
