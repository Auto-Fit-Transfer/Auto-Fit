    "ear": {
      "label_ko": "평균필요량",
      "label_en": "estimated average requirement"
    },
    "rni": {
      "label_ko": "권장섭취량",
      "label_en": "recommended nutrient intake"
    },
    "ai": {
      "label_ko": "충분섭취량",
      "label_en": "adequate intake"
    },
    "ul": {
      "label_ko": "상한섭취량",
      "label_en": "tolerable upper intake level"
    },
    "cdrr": {
      "label_ko": "만성질환위험감소섭취량",
      "label_en": "chronic disease risk reduction intake",
      "note": "상한섭취량과 다른 기준이다."
    },
    "amdr": {
      "label_ko": "에너지적정비율",
      "label_en": "acceptable macronutrient distribution range"
    }
  },
