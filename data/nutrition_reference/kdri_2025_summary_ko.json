  "scope": {
    "coverage": "Auto-Fit 식단 목표 산정에 직접 사용할 핵심 기준의 구조화본",
    "included": [
      "에너지 필요추정량",
      "탄수화물",
      "단백질",
      "지방 에너지적정비율",
      "식이섬유",
      "수분",
      "나트륨",
      "당류 및 콜레스테롤 일반 지침",
      "임신부 및 수유부 부가량"
    ],
    "excluded": [
      "개별 아미노산",
      "지용성 및 수용성 비타민",
      "콜린",
      "나트륨 외 다량무기질",
      "미량무기질"
    ],
    "intended_use": [
      "연령 및 성별 기준 집단의 영양 기준 조회",
      "Backend가 산정한 개인별 목표의 범위 검증",
      "식단 추천용 일일 및 끼니별 영양 목표 생성의 기준 데이터"
    ],
    "limitations": [
      "에너지 필요추정량은 기준 집단 값이며 개인의 키, 몸무게, 활동량과 건강 목표를 반영한 처방값이 아니다.",
      "개인별 목표는 Backend가 검증된 정책으로 계산하고 이 데이터는 기준 및 안전 범위로 사용한다.",
      "빈 표 셀은 0이 아니라 기준 미설정 또는 요약표 미제공을 뜻하므로 null로 저장한다.",
      "임신부 및 수유부 값은 별도 표시가 없는 한 동일 연령 기준에 더하는 부가량이다.",
      "현재 Auto-Fit 응답 정책은 메뉴 전체의 열량, 탄수화물, 단백질, 지방을 우선 사용한다."
    ]
  },
  "definitions": {
    "eer": {
      "label_ko": "에너지 필요추정량",
      "label_en": "estimated energy requirement"
